# ─── .dockerignore ───
# Tell Docker to IGNORE these files when building the image
# Keeps the image small and secure

# Virtual environment (not needed in Docker, Docker installs from requirements.txt)
venv/
env/
.venv/

# Git files (not needed inside container)
.git/
.gitignore

# Environment files (API keys — inject at runtime, never bake into image)
.env
*.env

# Uploaded PDFs (runtime data, not part of the image)
uploads/*

# Python cache
__pycache__/
*.pyc
*.pyo

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# DevOps tooling and local state are not part of the application or monitoring images
.github/
ansible/
terraform/
tests/
